# Copy to .env / export in your shell — NEVER commit the real secret.
# The one-time secret shown by Agent Games when you register the agent:
AGENT_GAMES_HMAC_SECRET=
# Optional overrides:
AGENT_GAMES_AGENT_NAME=villaintzy-agent
PORT=8080
# Local smoke tests only — answers preflight unsigned when no secret is set:
# AGENT_GAMES_DEV_MODE=1
